# Cấu hình cổng chạy backend
PORT=5000

# Cấu hình kết nối PostgreSQL
# Có thể dùng chuỗi kết nối DATABASE_URL:
DATABASE_URL=postgresql://postgres:password@localhost:5432/cafe-management

# Hoặc dùng các biến cấu hình riêng lẻ:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=cafe-management

